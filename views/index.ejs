<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Mini Project - Blog Posts</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/style.css">
    </head>
    <body>
        <nav class="navbar navbar-dark bg-dark px-4">
            <a href="/" class="navbar-brand">Blog Posts</a>
            <div class="text-white">
                <% if (currentUser) { %>
                    Welcome, <%= currentUser.name %>!
                    <form action="/logout" method="POST" class="d-inline">
                        <button class="btn btn-outline-light btn-sm">Sign Out</button>
                    </form>
                <% } else { %>
                    <a href="/signin" class="btn btn-outline-light btn-sm">Sign In</a>
                    <a href="/signup" class="btn btn-primary btn-sm">Sign Up</a>
                <% } %>
            </div>
        </nav>
        <main class="container py-4">
            <h1 class="mb-4">Posts</h1>
            <% if (currentUser) { %>
                <section class="form-card mb-4">
                    <h2>Create a Post</h2>
                    <form action="/blogs" method="POST">
                        <label for="title">Title</label>
                        <input type="text" name="title" id="title" required maxlength="255">
                        <label for="body">Content</label>
                        <textarea name="body" id="body" class="form-control mb-3" rows="4" required></textarea>
                        <button class="btn btn-primary" type="submit">Post</button>
                    </form>
                </section>
            <% } else { %>
                <p>Sign in to create your own blog posts.</p>
            <% } %>

            <% blogs.forEach(blog => { %>
                <article class="card blog-card mb-3">
                    <div class="card-body">
                        <h2 class="card-title"> <%= blog.title %></h2>
                        <p class="text-muted small">
                            By <% blog.creator_name %>
                            . <%= new Date(blog.date_created).toLocaleString() %>
                        </p>
                        <p class="card-text"><%= blog.body %></p>
                        <% if (currentUser && currentUser.user_id === blog.creator_user_id) { %>
                            <a href="/blogs/<%= blog.blog_id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
                            <form action="/blogs/<%= blog.blog_id %>/delete" method="POST" class="d-inline">
                                <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        </main>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>
